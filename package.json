{
  "name": "manga-translator-firefox-extension",
  "version": "3.1.1",
  "description": "Firefox extension to translate manga and manhwa images using free OCR and translation services",
  "private": true,
  "scripts": {
    "create-icons": "node icons/create_icons.js",
    "package": "python scripts/package.py",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "manga",
    "manhwa",
    "translator",
    "ocr",
    "firefox",
    "extension",
    "tesseract",
    "libretranslate"
  ],
  "author": "toufik-az",
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/toufik-az/Translate-image-extantion"
  },
  "bugs": {
    "url": "https://github.com/toufik-az/Translate-image-extantion/issues"
  },
  "homepage": "https://github.com/toufik-az/Translate-image-extantion#readme",
  "firefox": {
    "id": "manga-translator@example.com",
    "strict_min_version": "140.0"
  }
}
